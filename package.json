{
  "name": "stream-to-my-tv",
  "version": "1.0.0",
  "private": true,
  "description": "Strict LAN-only video streaming server with HTTP 206 Direct Play, real-time FFmpeg Remux, WebVTT subtitles, DLNA MediaServer, Roku ECP, and Web Receiver",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/server.test.ts test/seek-queue.test.ts test/sidecar-lifecycle.test.ts",
    "verify": "tsx scripts/verify-e2e.ts",
    "typecheck": "tsc --noEmit",
    "build:sidecar": "tsx scripts/build-sidecar.ts",
    "benchmark:sidecar": "tsx scripts/benchmark-sidecar.ts",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-desktop.ps1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
